# ===================================================
# KrishiMitra Backend API Environment Configuration
# ===================================================
# Supabase project URL
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Supabase Anonymous Key (client operations / public auth)
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Supabase Service Role Key (SERVER-ONLY - NEVER expose to frontend or git)
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Express Server Port
PORT=5000

# Allowed Frontend URL for strict CORS & Auth Email Redirects
FRONTEND_URL=http://localhost:3000

# Node Environment ('development' or 'production')
NODE_ENV=development

# Razorpay server-side credentials
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Google Gemini API (server-side only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
